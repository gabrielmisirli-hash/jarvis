{
  "name": "estudio-espectral",
  "private": true,
  "version": "2.0.0",
  "description": "Estúdio Espectral — PWA offline: imagem/BMP → WAV espectral, com reconstrução do espectrograma a partir do WAV exportado.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "calibrar": "vitest run tests/calibracao.test.ts",
    "e2e": "node e2e/offline.e2e.mjs"
  },
  "dependencies": {
    "@fontsource/arimo": "5.2.5",
    "@fontsource/roboto-condensed": "5.2.5",
    "dexie": "4.0.11",
    "fflate": "0.8.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@vitejs/plugin-react": "4.4.1",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-pwa": "1.0.0",
    "vitest": "3.1.3"
  }
}
